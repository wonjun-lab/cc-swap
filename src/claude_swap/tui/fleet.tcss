/* cc-swap Fleet screen (fork). Screen-scoped so cswap.tcss stays upstream's.
   Colors come from the registered cswap themes (theme.py).

   Every line is laid out FleetScreen._width() = width - 3 cells wide: one
   column of padding on the left, two on the right. The account area pads
   one column each side, so its spare column on the right is where the
   scrollbar goes when the accounts scroll; the tags on the right line up
   with the status note above them either way. */

FleetScreen {
    layout: vertical;
    background: $background;
}

#fx-status {
    height: 1;
    margin-top: 1;
    padding: 0 2 0 1;
}

#fx-attention {
    height: 1;
    padding: 0 2 0 1;
}

/* Sized to its content; FleetScreen caps max-height at what is left, so
   the narrow layout's expanded account sits right under the list. */
#fx-scroll {
    height: auto;
    min-height: 2;
    margin-top: 1;
    padding: 0 1 0 1;
    background: $background;
    overflow-x: hidden;
    scrollbar-size-vertical: 1;
}

#fx-body {
    height: auto;
    text-wrap: nowrap;
    text-overflow: clip;
}

#fx-expanded {
    height: auto;
    padding: 0 2 0 1;
    text-wrap: nowrap;
    text-overflow: clip;
}

#fx-keys {
    dock: bottom;
    height: 1;
    padding: 0 1;
}

FleetScreen.-compact #fx-status,
FleetScreen.-compact #fx-scroll {
    margin-top: 0;
}

/* -- swap strategy / account settings ---------------------------------------------- */

#fx-st-head, #fx-ac-head {
    height: 1;
    padding: 0 1;
}

#fx-st-body {
    height: auto;
    padding: 1 1 0 1;
}

#fx-st-preview {
    height: auto;
    padding: 1 2;
}

#fx-st-keys, #fx-ac-keys {
    dock: bottom;
    height: 1;
    padding: 0 2;
}

#fx-ac-table {
    height: auto;
    max-height: 60%;
    margin-top: 1;
    background: $background;
}

#fx-ac-table > .datatable--header {
    color: $secondary;
    background: $background;
}

#fx-ac-prompt {
    height: auto;
    padding: 0 2;
}

#fx-ac-menu {
    height: auto;
    padding: 1 2 0 1;
    background: $background;
}

#fx-ac-menu ListItem {
    background: transparent;
    padding: 0 1;
    border-left: thick $background;
}

#fx-ac-menu ListItem.-highlight,
#fx-ac-menu:focus ListItem.-highlight {
    color: $foreground;
    background: $surface;
    text-style: none;
    border-left: thick $primary;
}
